{
  "expo": {
    "name": "MyReader",
    "slug": "my-reader-mobile",
    "version": "0.12.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "myreadermobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ryoumon.myreadermobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6C568",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ryoumon.myreadermobile",
      "permissions": [
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "platforms": ["ios", "android"],
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "buildReactNativeFromSource": true
          },
          "android": {}
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "./plugins/with-readium-ios",
      "./plugins/with-android-desugaring",
      "./plugins/with-android-debug-network-config",
      "@kesha-antonov/react-native-background-downloader",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6C568",
          "dark": {
            "backgroundColor": "#1F1B17"
          }
        }
      ],
      "expo-font",
      "expo-image",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "my-reader-mobile",
          "organization": "myself-eu"
        }
      ],
      "expo-web-browser",
      [
        "react-native-app-auth",
        {
          "redirectUrls": ["ryoumon.myreadermobile.auth://onedrive/"]
        }
      ],
      "@sentry/react-native",
      "expo-asset",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsFileWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/epub+zip",
              "application/pdf",
              "application/vnd.comicbook+zip",
              "application/zip"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c512af78-d409-4b9e-a841-b7896e32c07a"
      }
    }
  }
}
