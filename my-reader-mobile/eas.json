{
  "cli": {
    "version": ">= 18.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.22.0",
      "pnpm": "11.7.0",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "ENTRY_FILE": "node_modules/expo-router/entry.js"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "node": "22.22.0",
      "pnpm": "11.7.0",
      "distribution": "internal",
      "env": {
        "ENTRY_FILE": "node_modules/expo-router/entry.js",
        "EXPO_PUBLIC_ENABLE_PERF_TOOLS": "true",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production": {
      "node": "22.22.0",
      "pnpm": "11.7.0",
      "autoIncrement": true,
      "env": {
        "ENTRY_FILE": "node_modules/expo-router/entry.js",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
