{
  "families": [
    {
      "key": "default",
      "labelKey": "reader.fontOptions.default",
      "languageLabelKeys": {
        "zh": "reader.fontOptions.defaultChinese"
      },
      "languages": ["*"],
      "platforms": ["desktop", "mobile"]
    },
    {
      "key": "serif",
      "labelKey": "reader.fontOptions.serif",
      "languages": ["latin"],
      "platforms": ["desktop", "mobile"],
      "readiumFamilies": {
        "desktop": "serif",
        "mobile": "serif"
      }
    },
    {
      "key": "sans",
