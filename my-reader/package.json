{
  "name": "my-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepare:reader-fonts": "node scripts/prepare-reader-fonts.mjs",
    "sync:design-tokens": "node ../scripts/sync-design-tokens.mjs",
    "tauri": "tauri",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:rust:coverage": "cd src-tauri && cargo llvm-cov --lib --text --summary-only",
    "test:e2e": "npm run test:e2e:frontend && npm run test:e2e:desktop",
    "test:e2e:frontend": "npx bddgen -c e2e-frontend/playwright.config.ts && npx playwright test -c e2e-frontend/playwright.config.ts",
    "test:e2e:frontend:ui": "npx bddgen -c e2e-frontend/playwright.config.ts && npx playwright test --ui -c e2e-frontend/playwright.config.ts",
    "test:e2e:desktop": "cd e2e && npx wdio run wdio.conf.ts",
    "build:frontend:e2e": "vite build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@my-reader/fonts": "workspace:*",
    "@my-reader/tools": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@readium/css": "^2.0.4",
    "@readium/navigator": "^2.5.1",
    "@readium/navigator-html-injectables": "^2.4.1",
    "@readium/shared": "^2.2.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-form": "^1.29.0",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-router": "^1.168.7",
    "@tanstack/react-router-devtools": "^1.166.11",
    "@tanstack/react-virtual": "^3.13.23",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-log": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "i18next": "^26.1.0",
    "lucide-react": "^1.7.0",
    "next-themes": "^0.4.6",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "p-timeout": "^7.0.1",
    "pdfjs-dist": "^5.5.207",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@my-reader/db": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@tanstack/router-plugin": "^1.167.8",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.6",
    "@wdio/cli": "^9.27.1",
    "@wdio/cucumber-framework": "^9.27.1",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/spec-reporter": "^9.27.1",
    "jsdom": "^29.0.2",
    "playwright-bdd": "^8.5.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.4",
    "webdriverio": "^9.27.1"
  }
}
