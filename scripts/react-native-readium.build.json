{
  "compilerOptions": {
    "baseUrl": "../packages/react-native-readium",
    "paths": {
      "react-native-readium": ["./src/index"]
    },
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-native",
    "lib": ["es2019", "DOM", "DOM.Iterable"],
    "moduleResolution": "node",
    "outDir": "../packages/react-native-readium/lib/src",
    "rootDir": "../packages/react-native-readium/src",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "esnext",
    "module": "esnext"
  },
  "include": [
    "../packages/react-native-readium/src/interfaces/**/*",
    "../packages/react-native-readium/src/utils/**/*",
    "../packages/react-native-readium/src/specs/ReadiumView.nitro.ts"
  ]
}
