# Maestro E2E environment variables.
# Maestro does NOT auto-load .env files — export these in your shell:
#   set -a && source e2e/.env.example && set +a
# or set them inline before the maestro command.

# ── Maestro AI backend ──────────────────────────────────────────────
# Required by @visual flows (assertWithAI / extractTextWithAI).
# AI commands route through Maestro Cloud. Two ways to authenticate:
#   1. `maestro login`  — interactive browser OAuth (free Maestro Cloud account)
#   2. export MAESTRO_CLOUD_API_KEY=<key>  — from https://cloud.mobile.dev
# (The legacy MAESTRO_CLI_AI_KEY / MAESTRO_CLI_AI_MODEL vars are NOT used.)
# Without this, @visual flows cannot run; use `--exclude-tags visual`.
MAESTRO_CLOUD_API_KEY=

# ── iOS driver ──────────────────────────────────────────────────────
# First run or after a Maestro update may need a longer XCTest driver startup.
MAESTRO_DRIVER_STARTUP_TIMEOUT=600000

# ── App ─────────────────────────────────────────────────────────────
# Bundle id, also passed via `maestro test -e APP_ID=...`.
APP_ID=ryoumon.myreadermobile
