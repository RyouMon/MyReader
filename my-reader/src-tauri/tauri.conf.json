{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyReader",
  "version": "0.12.0",
  "identifier": "ryoumon.myreader.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MyReader",
        "width": 800,
        "height": 600,
        "minWidth": 450,
        "minHeight": 450
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: bookcover: bookfile: blob: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: asset: bookcover: http://bookcover.localhost; script-src 'self'; font-src 'self'; frame-src blob:; media-src 'self' asset: bookcover: bookfile:",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$TEMP/**"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
