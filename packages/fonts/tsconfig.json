{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@my-reader/fonts": ["./src/index.ts"],
      "@my-reader/fonts/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.json", "tests/**/*.ts"]
}
