{
  "name": "my-reader-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "eas-build-post-install": "rm -rf node_modules/.cache",
    "postinstall": "patch-package",
    "sync:design-tokens": "node ../scripts/sync-design-tokens.mjs",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios --device",
    "lint": "expo lint",
    "test": "jest --watch",
    "test:ci": "jest --runInBand",
    "test:update-snapshots": "jest -u --coverage=false",
    "e2e:build:android:local": "npx eas-cli@latest build --platform android --profile e2e-test --local",
    "e2e:build:ios:local": "npx eas-cli@latest build --platform ios --profile e2e-test --local",
    "e2e:maestro:home": "maestro test .maestro/home.yml",
    "e2e:maestro:settings": "maestro test .maestro/settings.yml"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@config-plugins/react-native-blob-util": "^13.0.0",
    "@config-plugins/react-native-pdf": "^13.0.0",
    "@expo/metro-runtime": "~55.0.9",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-form": "^1.29.0",
    "clsx": "^2.1.1",
    "expo": "~55.0.13",
    "expo-build-properties": "^55.0.13",
    "expo-constants": "~55.0.13",
    "expo-dev-client": "55.0.24",
    "expo-file-system": "~55.0.16",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.8",
    "expo-linking": "~55.0.12",
    "expo-modules-core": "~55.0.22",
    "expo-router": "~55.0.11",
    "expo-secure-store": "^55.0.13",
    "expo-splash-screen": "~55.0.17",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.15",
    "lightningcss": "1.30.1",
    "my-reader-tools": "file:../my-reader-tools",
    "nativewind": "^5.0.0-preview.2",
    "pdfjs-dist": "^5.5.207",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-blob-util": "^0.24.7",
    "react-native-css": "^3.0.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-pdf": "^7.0.4",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "^0.7.4",
    "react-native-zip-archive": "^7.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.16",
    "patch-package": "^8.0.1",
    "react-test-renderer": "^19.2.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/tests/**/*-test.ts",
      "<rootDir>/tests/**/*-test.tsx",
      "**/?(*.)+(spec|test).[tj]s?(x)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^my-reader-tools/(.*)$": "<rootDir>/../my-reader-tools/src/$1",
      "^@babel/runtime/(.*)$": "<rootDir>/node_modules/@babel/runtime/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ]
  },
  "private": true
}
