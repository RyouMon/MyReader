{
  "name": "my-reader-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "eas-build-pre-install": "cd .. && pnpm install --frozen-lockfile",
    "eas-build-post-install": "rm -rf node_modules/.cache",
    "postinstall": "patch-package",
    "sync:design-tokens": "node ../scripts/sync-design-tokens.mjs",
    "start": "expo start",
    "android": "expo run:android --device",
    "ios": "expo run:ios --device",
    "lint": "expo lint",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "test:update-snapshots": "jest -u --coverage=false",
    "test:e2e": "maestro test e2e/maestro -e APP_ID=ryoumon.myreadermobile",
    "zip:fixtures": "cd ../calibre-library && zip -r ../my-reader-mobile/assets/e2e-fixtures/Example1.zip Example1/",
    "build:dev:android": "npx eas-cli@latest build --platform android --profile development --local",
    "build:dev:ios": "npx eas-cli@latest build --platform ios --profile development --local"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo/metro-runtime": "~55.0.9",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5",
    "@kesha-antonov/react-native-background-downloader": "^4.5.4",
    "@material/material-color-utilities": "^0.4.0",
    "@my-reader/db": "workspace:*",
    "@my-reader/tools": "workspace:*",
    "@noble/hashes": "^2.2.0",
    "@op-engineering/op-sqlite": "^15.2.11",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-menu/menu": "^2.0.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@ryoumon/react-native-readium": "^5.0.0-rc.20",
    "@sentry/react-native": "^8.11.0",
    "@shopify/flash-list": "2.0.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-form": "^1.29.0",
    "@tanstack/react-query": "^5.100.10",
    "babel-plugin-inline-import": "^3.0.0",
    "base-64": "^1.0.0",
    "chroma-js": "^3.2.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.40.0",
    "expo": "~55.0.13",
    "expo-asset": "~55.0.0",
    "expo-auth-session": "~55.0.16",
    "expo-build-properties": "^55.0.13",
    "expo-constants": "~55.0.13",
    "expo-crypto": "^55.0.14",
    "expo-dev-client": "55.0.24",
    "expo-file-system": "~55.0.16",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.8",
    "expo-linking": "~55.0.12",
    "expo-localization": "^55.0.14",
    "expo-modules-core": "~55.0.22",
    "expo-router": "~55.0.11",
    "expo-secure-store": "^55.0.13",
    "expo-splash-screen": "~55.0.17",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.15",
    "expo-web-browser": "~55.0.16",
    "fflate": "^0.8.2",
    "i18next": "^26.2.0",
    "ky": "^2.0.2",
    "lightningcss": "1.30.1",
    "nativewind": "^5.0.0-preview.2",
    "pdfjs-dist": "^5.5.207",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.83.4",
    "react-native-app-auth": "^8.3.0",
    "react-native-css": "^3.0.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-notifier": "^2.0.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "^0.7.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "op-sqlite": {
    "crsqlite": false,
    "performanceMode": true
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/base-64": "^1.0.2",
    "@types/chroma-js": "^3.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.16",
    "lint-staged": "^17.0.4",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/?(*.)+(spec|test).[tj]s?(x)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@my-reader/db/(.*)$": "<rootDir>/../packages/db/src/$1",
      "^@my-reader/tools/(.*)$": "<rootDir>/../packages/tools/src/$1"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "npx tsc --noEmit",
      "npm run lint -- --max-warnings=0"
    ]
  },
  "private": true
}
