+enum XCTestIssues {
+    private(set) static var count = 0
+    private(set) static var latest = ""
+
+    static func record(_ issue: XCTIssue) {
+        count += 1
+        latest = issue.compactDescription
+        NSLog("Kept serving after XCTest issue: \(latest)")
+    }
+}
