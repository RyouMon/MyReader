+
+@MainActor
+struct IssueReportingHandler: HTTPHandler {
+    let handler: HTTPHandler
+
+    func handleRequest(_ request: HTTPRequest) async throws -> HTTPResponse {
+        let issues = XCTestIssues.count
+        let response = try await handler.handleRequest(request)
+        return XCTestIssues.count == issues ? response : AppError(message: XCTestIssues.latest).httpResponse
+    }
+}
