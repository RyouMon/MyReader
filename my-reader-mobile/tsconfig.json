{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["jest"],
    "paths": {
      "@/src": [
        "./src"
      ],
      "@/tw": [
        "./src/tw/index.tsx"
      ],
      "@/tw/*": [
        "./src/tw/*"
      ],
      "@/*": [
        "./*"
      ],
      "@my-reader/tools/*": [
        "../packages/tools/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "../packages/tools/src/types/foliate-epub.d.ts"
  ],
  "exclude": [
    "app-example"
  ]
}